GEOID_BASE_URL=https://data.review.fao.org/geoid
MAX_REQUEST_BODY_SIZE_KB=1024
MAX_MAP_FEATURES=100
CARTO_BASEMAP_KEY=

# SSO - Authorization Code + PKCE via Auth.js against Keycloak.
# Sign-in stays off until KEYCLOAK_ISSUER is set; AUTH_SECRET is then required.
AUTH_SECRET=
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=geoid-fe
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SCOPE=openid email profile